# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-at-least-32-random-characters

# Comma-separated import names checked by list_installed_libraries.
MCP_EXTRA_MODULES=slugify

# DeepSeek API key for run_jwave_code_with_retry auto-fix (optional).
# If unset, run_jwave_code_with_retry raises an error; run_jwave_code still works.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
CODE_RETRY_MAX=7
