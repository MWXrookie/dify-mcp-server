@@ -870,20 +878,22 @@
 ```python
 import jwave as jw
 from jaxdf import FourierSeries
+import jax.numpy as jnp

 # 1. 定义介质
 domain = jw.Domain((128, 128), (0.1e-3, 0.1e-3))
 medium = jw.Medium(domain, sound_speed=1500.0, density=1000.0, pml_size=20)

-# 2. 定义时谐源 (1 MHz)
