  "cards": [
    {
      "dot": "cyan",
      "title": "入口与技能状态",
      "items": [
        "Web 门户提供问答、执行看板、报告、缓存和 Demo",
        "Dify 负责需求分析、参数提取、知识检索和代码生成",
        "工作流通过 MCP 工具调用执行仿真",
        "候选库仅内部使用；激活与检索未上线，退出成功不代表物理正确"
      ]
    },
    {
      "dot": "emerald",
      "title": "MCP 与质量门",
      "items": [
        "Bearer 鉴权；AST 与物理参数校验",
        "网关由标准场/时序生成热力图与波形图",
        "Q0-Q2 核验场、网格/PML 和参数；Q3/Q4 待场景规则与基准",
        "SQLite 候选按参数指纹去重；仅接收 Q2，拒绝自报 Q3/Q4"
      ]
    },
    {
      "dot": "rose",
      "title": "隔离执行与演进",
      "items": [
        "沙箱仅连 executor_internal，代码上限 20KB、执行 1-30s",
        "read_only、cap_drop ALL、pids 256、内存 4GB、CPU 2 核",
        "BYOK：公网 HTTPS/443，无重定向；管理写入须令牌与审计"
      ]
    }
  ]
