, "model": {"name": "deepseek-v4-flash", "provider": "langgenius/deepseek/deepseek", "completion_params": {"temperature": 0.7}, "mode": "chat"}, "selected": false}, "position": {"y": 282, "x": 1165.1614897520058}, "type": "custom", "height": 87, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "1783991079665", "positionAbsolute": {"x": 1550.4773256211458, "y": 282}, "data": {"prompt_template": [{"id": "961f94cd-f0ed-4ca0-ab49-7d797d67f6a6", "role": "system", "text": ""}, {"id": "1562435c-7ca5-40fb-8e7d-fa8b2c5496e6", "role": "user", "text": "你是 jwave Python 代码生成器。\n\n# 输出规则（最高优先级）\n你的输出就是最终要执行的Python代码。没有JSON包裹，没有markdown标记，没有任何其他文字。\n输出的第一个字符必须是 import 或 # （注释）。\n输出的每一行都是有效的Python代码。\n\n你会收到：\n- 用户需求：{{#1783990934733.query#}}\n- 仿真参数：{{#1783991048409.text#}}\n\n# jwave 0.2.1 API 参考（已验证，必须严格遵守！）\n\nimport jax\nimport jax.numpy as jnp\nfrom jwave import FourierSeries\nfrom jwave.geometry import Domain, Medium, TimeAxis, Sources\nfrom jwave.acoustics import simulate_wave_propagation\n\n## Domain\ndomain = Domain(N=(Nx, Ny), dx=(dx, dx))\n\n## Medium\nmedium = Medium(domain=domain, sound_speed=1540.0, density=1050.0)\n\n## TimeAxis\ntime_axis = TimeAxis.from_medium(medium, cfl=0.3, t_end=5e-6)\nt = time_axis.to_array()  # 1D array, shape (Nt,)\n\n## Sources —— 4个位置参数，不能用关键字\npositions = (jnp.array([cx]), jnp.array([cy]))\nsignals = jnp.expand_dims(jnp.sin(2*jnp.pi*freq*t), 0)  # 2D (1,Nt)\nsources = Sources(positions, signals, time_axis.dt, domain)\n\n## simulate_wave_propagation\np = simulate_wave_propagation(medium, time_axis, sources=sources)\npressure = p.params[0]\n\nprint(f\"压力场形状: {pressure.shape}\")\nprint(f\"最大压力: {float(pressure.max()):.6f}\")\n"}], "context": {"enabled": false, "variable_selector": []}, "structured_output_enabled": false, "title": "代码生成", "type": "llm", "vision": {"enabled": false}, "model": {"name": "deepseek-coder", "provider": "langgenius/deepseek/deepseek", "completion_params": {"